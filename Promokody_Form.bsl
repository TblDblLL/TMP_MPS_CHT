// Модуль управляемой формы внешней обработки «ГенераторПромокодов».
// Все реквизиты формы и команды перечислены в README.md.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Наименование = "Новый формат";
	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	СМаркером = Ложь;
	Маркер = "";
	ПозицияМаркера = 1;
	ДлинаПромокода = 11;
	МаксимальноеКоличество = 20000;
	КоличествоКСозданию = 100;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьРезультат();
КонецПроцедуры

&НаКлиенте
Процедура ПараметрПриИзменении(Элемент)
	ОбновитьРезультат();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	ОбновитьРезультат();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультат()
	Проверка = ПроверитьФорматНаСервере(Наименование, Алфавит, СМаркером,
		Маркер, ПозицияМаркера, ДлинаПромокода,
		МаксимальноеКоличество, КоличествоКСозданию);
	Если Проверка.Успех Тогда
		РезультатПроверки = "Формат заполнен корректно";
		Маска = Проверка.Маска;
		Вероятность = Проверка.Вероятность;
	Иначе
		РезультатПроверки = Проверка.Сообщение;
		Маска = "";
		Вероятность = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сгенерировать(Команда)
	Ответ = СгенерироватьНаСервере(Наименование, Алфавит, СМаркером,
		Маркер, ПозицияМаркера, ДлинаПромокода,
		МаксимальноеКоличество, КоличествоКСозданию);
	Если НЕ Ответ.Успех Тогда
		Сообщить(Ответ.Сообщение);
		ОбновитьРезультат();
		Возврат;
	КонецЕсли;
	Промокоды.Очистить();
	Для Каждого Код Из Ответ.Коды Цикл
		СтрокаТаблицы = Промокоды.Добавить();
		СтрокаТаблицы.Промокод = Код;
	КонецЦикла;
	Сообщить("Создано уникальных промокодов: " + Формат(Ответ.Коды.Количество(), "ЧГ=0;ЧДЦ=0"));
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьФорматНаСервере(ИмяФормата, ВыбранныйАлфавит,
	ЕстьМаркер, ТекстМаркера, Позиция, Длина, Максимум, Количество)

	Ответ = Новый Структура;
	Ответ.Вставить("Успех", Ложь);
	Ответ.Вставить("Сообщение", "");
	ПолныйАлфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";

	Если ПустаяСтрока(СокрЛП(ИмяФормата)) Тогда
		Ответ.Сообщение = "Укажите название формата.";
		Возврат Ответ;
	КонецЕсли;

	РабочийАлфавит = СокрЛП(ВыбранныйАлфавит);
	Если ПустаяСтрока(РабочийАлфавит) Тогда
		Ответ.Сообщение = "Выберите хотя бы один символ алфавита.";
		Возврат Ответ;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(РабочийАлфавит) Цикл
		Символ = Сред(РабочийАлфавит, Номер, 1);
		Если Найти(ПолныйАлфавит, Символ) = 0 Тогда
			Ответ.Сообщение = "Алфавит допускает только цифры 0–9 и заглавные буквы A–Z.";
			Возврат Ответ;
		КонецЕсли;
		Если Найти(Лев(РабочийАлфавит, Номер - 1), Символ) > 0 Тогда
			Ответ.Сообщение = "В алфавите есть повторяющийся символ: " + Символ;
			Возврат Ответ;
		КонецЕсли;
	КонецЦикла;

	Если Длина <> Цел(Длина) Или Длина < 1 Или Длина > 20 Тогда
		Ответ.Сообщение = "Длина промокода должна быть целым числом от 1 до 20.";
		Возврат Ответ;
	КонецЕсли;
	Если Максимум <> Цел(Максимум) Или Максимум < 1 Или Максимум > 100000 Тогда
		Ответ.Сообщение = "Максимальное количество должно быть целым числом от 1 до 100 000.";
		Возврат Ответ;
	КонецЕсли;
	Если Количество <> Цел(Количество) Или Количество < 1 Или Количество > Максимум Тогда
		Ответ.Сообщение = "Количество к созданию должно быть от 1 до установленного максимума.";
		Возврат Ответ;
	КонецЕсли;

	РабочийМаркер = "";
	СлучайныхПозиций = Длина;
	Если ЕстьМаркер Тогда
		РабочийМаркер = СокрЛП(ТекстМаркера);
		Если ПустаяСтрока(РабочийМаркер) Тогда
			Ответ.Сообщение = "Укажите маркер.";
			Возврат Ответ;
		КонецЕсли;
		Для Номер = 1 По СтрДлина(РабочийМаркер) Цикл
			Если Найти(ПолныйАлфавит, Сред(РабочийМаркер, Номер, 1)) = 0 Тогда
				Ответ.Сообщение = "Маркер допускает только цифры 0–9 и заглавные буквы A–Z.";
				Возврат Ответ;
			КонецЕсли;
		КонецЦикла;
		СлучайныхПозиций = Длина - СтрДлина(РабочийМаркер);
		Если СлучайныхПозиций < 1 Тогда
			Ответ.Сообщение = "Длина должна быть больше длины маркера.";
			Возврат Ответ;
		КонецЕсли;
		Если Позиция <> Цел(Позиция) Или Позиция < 1
			Или Позиция > СлучайныхПозиций + 1 Тогда
			Ответ.Сообщение = "Позиция маркера должна быть от 1 до "
				+ Формат(СлучайныхПозиций + 1, "ЧГ=0;ЧДЦ=0") + ".";
			Возврат Ответ;
		КонецЕсли;
	КонецЕсли;

	// 36^20 помещается в точность числа платформы (38 десятичных цифр).
	Вариантов = 1;
	Для Номер = 1 По СлучайныхПозиций Цикл
		Вариантов = Вариантов * СтрДлина(РабочийАлфавит);
	КонецЦикла;
	Если Максимум > Вариантов Тогда
		Ответ.Сообщение = "Максимальное количество больше числа возможных уникальных кодов ("
			+ Формат(Вариантов, "ЧГ=0;ЧДЦ=0") + ").";
		Возврат Ответ;
	КонецЕсли;

	МаскаКода = "";
	Для Номер = 1 По СлучайныхПозиций Цикл
		МаскаКода = МаскаКода + "*";
	КонецЦикла;
	Если ЕстьМаркер Тогда
		МаскаКода = Лев(МаскаКода, Позиция - 1) + РабочийМаркер
			+ Сред(МаскаКода, Позиция);
	КонецЕсли;

	Ответ.Вставить("Успех", Истина);
	Ответ.Вставить("Алфавит", РабочийАлфавит);
	Ответ.Вставить("Маркер", РабочийМаркер);
	Ответ.Вставить("СлучайныхПозиций", СлучайныхПозиций);
	Ответ.Вставить("Вариантов", Вариантов);
	Ответ.Вставить("Маска", МаскаКода);
	// Вероятность указана для максимального числа выпущенных кодов.
	Ответ.Вставить("Вероятность", Формат(Максимум, "ЧГ=0;ЧДЦ=0")
		+ " / " + Формат(Вариантов, "ЧГ=0;ЧДЦ=0")
		+ " (примерно 1 / " + Формат(Окр(Вариантов / Максимум, 0), "ЧГ=0;ЧДЦ=0") + ")");
	Возврат Ответ;
КонецФункции

&НаСервереБезКонтекста
Функция СгенерироватьНаСервере(ИмяФормата, ВыбранныйАлфавит,
	ЕстьМаркер, ТекстМаркера, Позиция, Длина, Максимум, Количество)

	Ответ = ПроверитьФорматНаСервере(ИмяФормата, ВыбранныйАлфавит,
		ЕстьМаркер, ТекстМаркера, Позиция, Длина, Максимум, Количество);
	Если НЕ Ответ.Успех Тогда
		Возврат Ответ;
	КонецЕсли;

	Коды = Новый Массив;
	Генератор = Новый ГенераторСлучайныхЧисел;
	РазмерАлфавита = СтрДлина(Ответ.Алфавит);

	Если Ответ.Вариантов <= 2000000000 Тогда
		// Разреженное перемешивание индексов: без повторов и без полного массива вариантов.
		Подстановки = Новый Соответствие;
		Осталось = Ответ.Вариантов;
		Для НомерКода = 1 По Количество Цикл
			СлучайныйИндекс = Генератор.СлучайноеЧисло(0, Осталось - 1);
			ВыбранныйИндекс = Подстановки.Получить(СлучайныйИндекс);
			Если ВыбранныйИндекс = Неопределено Тогда
				ВыбранныйИндекс = СлучайныйИндекс;
			КонецЕсли;
			ПоследнийИндекс = Осталось - 1;
			ПоследнееЗначение = Подстановки.Получить(ПоследнийИндекс);
			Если ПоследнееЗначение = Неопределено Тогда
				ПоследнееЗначение = ПоследнийИндекс;
			КонецЕсли;
			Подстановки.Вставить(СлучайныйИндекс, ПоследнееЗначение);
			Осталось = Осталось - 1;
			Коды.Добавить(КодПоИндексу(ВыбранныйИндекс, Ответ.Алфавит,
				Ответ.СлучайныхПозиций, ЕстьМаркер, Ответ.Маркер, Позиция));
		КонецЦикла;
	Иначе
		УжеСозданы = Новый Соответствие;
		Пока Коды.Количество() < Количество Цикл
			СлучайнаяЧасть = "";
			Для Номер = 1 По Ответ.СлучайныхПозиций Цикл
				СлучайнаяЧасть = СлучайнаяЧасть + Сред(Ответ.Алфавит,
					Генератор.СлучайноеЧисло(1, РазмерАлфавита), 1);
			КонецЦикла;
			Код = ВставитьМаркер(СлучайнаяЧасть, ЕстьМаркер, Ответ.Маркер, Позиция);
			Если УжеСозданы.Получить(Код) = Неопределено Тогда
				УжеСозданы.Вставить(Код, Истина);
				Коды.Добавить(Код);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Ответ.Вставить("Коды", Коды);
	Возврат Ответ;
КонецФункции

&НаСервереБезКонтекста
Функция ВставитьМаркер(СлучайнаяЧасть, ЕстьМаркер, МаркерКода, Позиция)
	Если НЕ ЕстьМаркер Тогда
		Возврат СлучайнаяЧасть;
	КонецЕсли;
	Возврат Лев(СлучайнаяЧасть, Позиция - 1) + МаркерКода
		+ Сред(СлучайнаяЧасть, Позиция);
КонецФункции

&НаСервереБезКонтекста
Функция КодПоИндексу(Индекс, АлфавитКода, ЧислоПозиций,
	ЕстьМаркер, МаркерКода, Позиция)
	Размер = СтрДлина(АлфавитКода);
	ЧастьКода = "";
	Для Номер = 1 По ЧислоПозиций Цикл
		Частное = Цел(Индекс / Размер);
		Остаток = Индекс - Частное * Размер;
		ЧастьКода = Сред(АлфавитКода, Остаток + 1, 1) + ЧастьКода;
		Индекс = Частное;
	КонецЦикла;
	Возврат ВставитьМаркер(ЧастьКода, ЕстьМаркер, МаркерКода, Позиция);
КонецФункции
